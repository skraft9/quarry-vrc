# Quarry VRC configuration. Copy to `.env` and edit. `.env` is git-ignored.
# HackerOne API credentials are NOT set here - you paste them once in the Integrations tab, so they
# are stored server-side and never rendered back. Everything below is optional except the password.

# --- required ------------------------------------------------------------------------------------
# The first admin login is created from this on first boot. The server refuses to start without it.
# It must be at least QUARRY_MIN_PASSWORD_LENGTH characters (default 12).
QUARRY_ADMIN_PASSWORD=

# Minimum password length the server enforces, for the admin bootstrap and any later change.
# Default 12. Lower it only on a private, single-operator box where you want a short login.
QUARRY_MIN_PASSWORD_LENGTH=12

# --- identity ------------------------------------------------------------------------------------
QUARRY_ADMIN_USER=admin
# Shown in the top-left brand and the page title. Rename it to whatever you like.
QUARRY_APP_NAME=Quarry VRC

# --- network -------------------------------------------------------------------------------------
# Host port the HTTPS console is published on (container always serves 8443 internally).
QUARRY_PORT=8443
# IP allow-list, checked before auth on every request. Empty = open (fine for a machine you run
# yourself). Comma-separated bare IPs and/or CIDRs to lock it down, e.g. 192.168.1.0/24,10.0.0.5
QUARRY_ALLOWLIST=

# --- TLS -----------------------------------------------------------------------------------------
# `self-signed` generates a local CA + cert on first boot (default). Set to `mounted` and mount your
# own cert/key into /data/tls to bring your own.
QUARRY_TLS_MODE=self-signed

# --- Payloads ------------------------------------------------------------------------------------
# The payload arsenal is a shallow clone of a public reference, pulled into the payloads volume on
# first boot and indexed into the searchable Payloads tab. Nothing is vendored in the image. Point
# this at any repo of markdown with fenced code blocks to bring your own.
QUARRY_PAYLOADS_REPO=https://github.com/swisskyrepo/PayloadsAllTheThings.git
